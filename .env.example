# ==========================================
# BidSentinel Environment Configuration
# ==========================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=bidsentinel-sih-secret-key-2026-supersecure-prototype
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite (no separate database server installation needed)
# Production Migration: postgresql://postgres:password@localhost:5432/bidsentinel
DATABASE_URL=sqlite:///./bidsentinel.db

# Demo Officer Credentials
DEMO_OFFICER_EMAIL=officer@gem-demo.gov.in
DEMO_OFFICER_PASSWORD=demo123

# Integration Flags
PROTOTYPE_MODE=true
GOVT_SOURCE_LABEL=Prototype / Mock Government Connector

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
